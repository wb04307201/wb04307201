#!/usr/bin/env bash
# commit-msg hook: 检查 commit message 规范 + 数字虚报警告
#
# Session 7 (2026-09-02) 新增：阻止"虚报 commit"和"数字虚报"两类问题
#
# 安装: git config core.hooksPath .githooks（推荐，可追踪）

set -e

COMMIT_MSG_FILE="$1"

# 委托 Python 实现（处理中文 scope 兼容）
python - "$COMMIT_MSG_FILE" << 'PYEOF'
import sys
# Windows GBK 兼容
if sys.platform == 'win32':
    try:
        sys.stdout.reconfigure(encoding='utf-8')
    except Exception:
        pass
import sys, re

msg_file = sys.argv[1]
with open(msg_file, encoding='utf-8', errors='ignore') as f:
    msg = f.read()

print('[commit-msg] 校验 commit message...')

# 1. 提交格式检查（基于 commit 类型前缀）
# 允许 scope 包含 ASCII + 中文（用 Unicode 范围 一-龥）
PATTERN = re.compile(
    r'^(feat|fix|docs|refactor|style|test|perf|chore|revert|ci|build)'
    r'(\([\w.\-/一-鿿]+\))?!?: .+',
    re.UNICODE
)

lines = msg.split('\n')
title = lines[0]

if not PATTERN.match(title):
    print('')
    print('❌ Commit 标题不符合 Conventional Commits 规范')
    print('')
    print(f'   当前: {title[:80]}')
    print('')
    print('   要求格式: <type>(<scope>): <description>')
    print('   允许 type: feat/fix/docs/refactor/style/test/perf/chore/revert/ci/build')
    print('   允许 scope: ASCII + 中文（中文需用 Unicode \\u4e00-\\u9fff）')
    print('   例: feat(09.ai-applications): RAG 章节新增 3 篇')
    print('   例: fix(structure): 修断链 230 处')
    print('')
    print('   跳过（merge / revert 自动生成）：git commit --no-verify')
    sys.exit(1)

# 2. 标题长度检查（≤ 72 字符）
if len(title) > 72:
    print('')
    print(f'❌ Commit 标题过长（{len(title)} 字符，限 72）')
    print(f'   当前: {title}')
    sys.exit(1)

# 3. 数字虚报检测（Session 6 教训）—— 警告级别
DIGITS_PATTERN = re.compile(r'([0-9]+)\s*(篇|处|个|项|次|分|pp|%)')
matches = DIGITS_PATTERN.findall(title + '\n' + msg)

if matches:
    digits = [f'{n}{u}' for n, u in matches[:5]]
    print(f'[commit-msg] ⚠ 检测到数字声明：{", ".join(digits)}')
    print('[commit-msg]   提醒：数字应与 git diff 实际结果一致（避免虚报）')
    print('[commit-msg]   可用 git diff --stat 核对')

print('[commit-msg] ✅ 通过')
PYEOF